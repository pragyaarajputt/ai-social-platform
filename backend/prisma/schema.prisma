generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN

  @@map("role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("token_type")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER

  @@map("workspace_role")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  THREADS
  LINKEDIN
  X
  YOUTUBE
  TIKTOK

  @@map("social_platform")
}

enum SocialAccountStatus {
  ACTIVE
  /// Token expired or was rejected; the user must reconnect.
  NEEDS_REAUTH
  /// The user removed our app on the platform (deauthorize callback).
  REVOKED
  /// Disconnected from our side; tokens deleted.
  DISCONNECTED

  @@map("social_account_status")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  /// Stored lowercase so uniqueness is case-insensitive.
  username        String     @unique @db.VarChar(30)
  /// Null for accounts that only sign in with OAuth.
  passwordHash    String?    @map("password_hash")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile            Profile?
  settings           UserSettings?
  refreshTokens      RefreshToken[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]

  memberships        WorkspaceMember[]
  connectedAccounts  SocialAccount[]
  auditLogs          AuditLog[]
  oauthConnectStates OAuthConnectState[]

  @@map("users")
}

model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(50)
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  notificationPrefs Json     @default("{}") @map("notification_prefs")
  aiPrefs           Json     @default("{}") @map("ai_prefs")
  locale            String   @default("en") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// All tokens from one login share a family; reuse of a revoked token revokes the family.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Single-use tokens for email verification and password reset. Only the hash is stored.
model VerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ─── Workspaces ──────────────────────────────────────────────────────────────

/// Everything users create (connected accounts, posts, media) belongs to a workspace, not a user.
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(60)
  /// IANA time zone, used for scheduling and calendar display.
  timezone  String   @default("UTC") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members        WorkspaceMember[]
  socialAccounts SocialAccount[]
  connectStates  OAuthConnectState[]
  auditLogs      AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ─── Social integrations ─────────────────────────────────────────────────────

/// A social media account connected to a workspace (e.g. an Instagram business account).
model SocialAccount {
  id            String              @id @default(uuid(7)) @db.Uuid
  workspaceId   String              @map("workspace_id") @db.Uuid
  platform      SocialPlatform
  /// The account's ID on the platform (for Instagram: the professional account ID used to publish).
  externalId    String              @map("external_id") @db.VarChar(100)
  /// App-scoped user ID, where the platform has one. Meta's deauthorize and data-deletion
  /// callbacks identify the user by this ID.
  appScopedId   String?             @map("app_scoped_id") @db.VarChar(100)
  /// Platform-specific kind, e.g. BUSINESS or CREATOR for Instagram.
  accountType   String?             @map("account_type") @db.VarChar(30)
  username      String?             @db.VarChar(100)
  name          String?             @db.VarChar(200)
  avatarUrl     String?             @map("avatar_url")
  status        SocialAccountStatus @default(ACTIVE)
  connectedById String?             @map("connected_by_id") @db.Uuid
  lastCheckedAt DateTime?           @map("last_checked_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?       @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  token       OAuthToken?

  @@unique([workspaceId, platform, externalId])
  @@index([platform, externalId])
  @@index([platform, appScopedId])
  @@map("social_accounts")
}

/// Platform access tokens, encrypted at rest (see utils/tokenCrypto.ts). Kept in their own table
/// so they are never loaded by accident with the account.
model OAuthToken {
  socialAccountId String    @id @map("social_account_id") @db.Uuid
  accessTokenEnc  String    @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  scopes          String[]  @default([])
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(3)
  failureCount    Int       @default(0) @map("failure_count")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_tokens")
}

/// Short-lived `state` for the connect flow, so a callback can only complete a flow we started.
model OAuthConnectState {
  id          String         @id @default(uuid(7)) @db.Uuid
  stateHash   String         @unique @map("state_hash")
  userId      String         @map("user_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  platform    SocialPlatform
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("oauth_connect_states")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  /// e.g. social_account.connected, social_account.token_refresh_failed
  action      String   @db.VarChar(80)
  targetType  String?  @map("target_type") @db.VarChar(40)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
