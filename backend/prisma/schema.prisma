generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN

  @@map("role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@map("token_type")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER

  @@map("workspace_role")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  THREADS
  LINKEDIN
  X
  YOUTUBE
  TIKTOK
  BLUESKY

  @@map("social_platform")
}

enum SocialAccountStatus {
  ACTIVE
  /// Token expired or was rejected; the user must reconnect.
  NEEDS_REAUTH
  /// The user removed our app on the platform (deauthorize callback).
  REVOKED
  /// Disconnected from our side; tokens deleted.
  DISCONNECTED

  @@map("social_account_status")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique
  /// Stored lowercase so uniqueness is case-insensitive.
  username        String     @unique @db.VarChar(30)
  /// Null for accounts that only sign in with OAuth.
  passwordHash    String?    @map("password_hash")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile            Profile?
  settings           UserSettings?
  refreshTokens      RefreshToken[]
  oauthAccounts      OAuthAccount[]
  verificationTokens VerificationToken[]

  memberships        WorkspaceMember[]
  connectedAccounts  SocialAccount[]
  uploadedMedia      MediaAsset[]
  posts              Post[]
  auditLogs          AuditLog[]
  oauthConnectStates OAuthConnectState[]
  aiRequests         AiRequest[]
  brandVoiceEdits    BrandVoice[]
  invitesSent        WorkspaceInvite[]   @relation("InvitedBy")
  invitesAccepted    WorkspaceInvite[]   @relation("AcceptedBy")

  @@map("users")
}

model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(50)
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  notificationPrefs Json     @default("{}") @map("notification_prefs")
  aiPrefs           Json     @default("{}") @map("ai_prefs")
  locale            String   @default("en") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// All tokens from one login share a family; reuse of a revoked token revokes the family.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Single-use tokens for email verification and password reset. Only the hash is stored.
model VerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ─── Workspaces ──────────────────────────────────────────────────────────────

/// Everything users create (connected accounts, posts, media) belongs to a workspace, not a user.
model Workspace {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.VarChar(80)
  slug       String   @unique @db.VarChar(60)
  /// IANA time zone, used for scheduling and calendar display.
  timezone   String   @default("UTC") @db.VarChar(64)
  /// Created at sign-up. It can't be deleted while it's the owner's only workspace.
  isPersonal Boolean  @default(false) @map("is_personal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members        WorkspaceMember[]
  socialAccounts SocialAccount[]
  connectStates  OAuthConnectState[]
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  aiRequests     AiRequest[]
  brandVoice     BrandVoice?
  invites        WorkspaceInvite[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/**
 * An invitation to join a workspace, sent by email. Only the token's hash is stored; the link works
 * once, for 7 days, and only for a signed-in user with the same verified email. One pending invite
 * per email per workspace (partial unique index in migration team_invites); inviting again resends it.
 */
model WorkspaceInvite {
  id           String        @id @default(uuid(7)) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  /// Lowercase.
  email        String        @db.VarChar(254)
  /// Never OWNER: ownership is only transferred.
  role         WorkspaceRole
  tokenHash    String        @unique @map("token_hash")
  invitedById  String?       @map("invited_by_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  lastSentAt   DateTime      @map("last_sent_at") @db.Timestamptz(3)
  acceptedAt   DateTime?     @map("accepted_at") @db.Timestamptz(3)
  acceptedById String?       @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("workspace_invites")
}

// ─── Social integrations ─────────────────────────────────────────────────────

/// A social media account connected to a workspace (e.g. an Instagram business account).
model SocialAccount {
  id                String              @id @default(uuid(7)) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  platform          SocialPlatform
  /// The account's ID on the platform (for Instagram: the professional account ID used to publish).
  externalId        String              @map("external_id") @db.VarChar(100)
  /// App-scoped user ID, where the platform has one. Meta's deauthorize and data-deletion
  /// callbacks identify the user by this ID.
  appScopedId       String?             @map("app_scoped_id") @db.VarChar(100)
  /// Platform-specific kind, e.g. BUSINESS or CREATOR for Instagram.
  accountType       String?             @map("account_type") @db.VarChar(30)
  username          String?             @db.VarChar(100)
  name              String?             @db.VarChar(200)
  avatarUrl         String?             @map("avatar_url")
  status            SocialAccountStatus @default(ACTIVE)
  connectedById     String?             @map("connected_by_id") @db.Uuid
  lastCheckedAt     DateTime?           @map("last_checked_at") @db.Timestamptz(3)
  /// The platform let us read insights (Instagram: instagram_business_manage_insights). Set on
  /// connect from the granted permissions; cleared when the platform refuses an insights call.
  insightsAllowed   Boolean             @default(false) @map("insights_allowed")
  /// When the "when followers are online" data was last fetched.
  audienceFetchedAt DateTime?           @map("audience_fetched_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  token       OAuthToken?
  postTargets PostTarget[]
  dailyStats  AccountDailyStats[]
  audience    AccountAudience?

  @@unique([workspaceId, platform, externalId])
  // Also: a platform account can be ACTIVE or NEEDS_REAUTH in only one workspace at a time. Prisma
  // can't express partial unique indexes, so it's created in SQL (migration connection_hardening:
  // social_accounts_one_active_workspace).
  @@index([platform, externalId])
  @@index([platform, appScopedId])
  @@map("social_accounts")
}

/// Platform access tokens, encrypted at rest (see utils/tokenCrypto.ts). Kept in their own table
/// so they are never loaded by accident with the account.
model OAuthToken {
  socialAccountId String    @id @map("social_account_id") @db.Uuid
  accessTokenEnc  String    @map("access_token_enc")
  refreshTokenEnc String?   @map("refresh_token_enc")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  scopes          String[]  @default([])
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(3)
  failureCount    Int       @default(0) @map("failure_count")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_tokens")
}

/// Short-lived `state` for the connect flow, so a callback can only complete a flow we started.
model OAuthConnectState {
  id              String         @id @default(uuid(7)) @db.Uuid
  stateHash       String         @unique @map("state_hash")
  /// PKCE code_verifier for platforms that use it, encrypted like tokens. Single use, like the state.
  codeVerifierEnc String?        @map("code_verifier_enc")
  userId          String         @map("user_id") @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  platform        SocialPlatform
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("oauth_connect_states")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  /// e.g. social_account.connected, social_account.token_refresh_failed
  action      String   @db.VarChar(80)
  targetType  String?  @map("target_type") @db.VarChar(40)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Content & publishing ────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum PostStatus {
  DRAFT
  /// Every account is waiting for the scheduled time.
  SCHEDULED
  PUBLISHING
  PUBLISHED
  /// Published to some accounts, failed on others.
  PARTIALLY_FAILED
  FAILED
  CANCELLED

  @@map("post_status")
}

enum PostFormat {
  /// Text only (Facebook).
  TEXT
  IMAGE
  /// Several photos (and on Instagram, videos): an Instagram carousel or a Facebook multi-photo post.
  CAROUSEL
  REEL
  /// A regular (non-Reel) video post (Facebook).
  VIDEO

  @@map("post_format")
}

enum TargetStatus {
  /// Waiting for its scheduled time; can still be edited or cancelled.
  SCHEDULED
  QUEUED
  PUBLISHING
  /// The platform is still processing uploaded video; checked again later.
  WAITING_FOR_MEDIA
  PUBLISHED
  FAILED
  CANCELLED

  @@map("target_status")
}

/// A file in the workspace's media library, stored on Cloudinary.
model MediaAsset {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  publicId     String    @map("public_id") @db.VarChar(255)
  type         MediaType
  /// Original format as uploaded, e.g. "png", "mp4".
  format       String    @db.VarChar(20)
  bytes        Int
  width        Int
  height       Int
  durationSec  Float?    @map("duration_sec")
  secureUrl    String    @map("secure_url")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  posts      PostMedia[]

  @@unique([workspaceId, publicId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("media_assets")
}

/// Content written once; published to one or more accounts through its targets.
model Post {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  authorId    String?    @map("author_id") @db.Uuid
  caption     String     @default("")
  status      PostStatus @default(DRAFT)
  /// When the post should go out (UTC). Null means "publish now".
  scheduledAt DateTime?  @map("scheduled_at") @db.Timestamptz(3)
  /// An AI suggestion was applied while writing this post. For the workspace's own tracking only.
  aiAssisted  Boolean    @default(false) @map("ai_assisted")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  media     PostMedia[]
  targets   PostTarget[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, scheduledAt])
  @@map("posts")
}

model PostMedia {
  postId       String @map("post_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  position     Int

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([postId, position])
  @@index([mediaAssetId])
  @@map("post_media")
}

/// One post going to one account. Also the publish job: the worker claims rows whose
/// next_attempt_at has passed (SELECT ... FOR UPDATE SKIP LOCKED), see jobs/publishQueue.ts.
model PostTarget {
  id                String       @id @default(uuid(7)) @db.Uuid
  postId            String       @map("post_id") @db.Uuid
  socialAccountId   String       @map("social_account_id") @db.Uuid
  captionOverride   String?      @map("caption_override")
  format            PostFormat
  status            TargetStatus @default(QUEUED)
  /// The time the user chose. Unlike next_attempt_at, retries never change it.
  scheduledAt       DateTime?    @map("scheduled_at") @db.Timestamptz(3)
  /// When the "this scheduled post will probably fail" warning was sent, so it is sent only once.
  preflightWarnedAt DateTime?    @map("preflight_warned_at") @db.Timestamptz(3)
  /// When the worker should next pick this up (publish time now; scheduled time in Phase 6).
  nextAttemptAt     DateTime?    @map("next_attempt_at") @db.Timestamptz(3)
  /// Set while a worker is processing it; an expired lock means the worker died.
  lockedUntil       DateTime?    @map("locked_until") @db.Timestamptz(3)
  attempts          Int          @default(0)
  /// Platform progress saved as soon as it happens (e.g. container IDs), so retries never repeat a step.
  platformState     Json         @default("{}") @map("platform_state")
  externalPostId    String?      @map("external_post_id") @db.VarChar(100)
  permalink         String?
  publishedAt       DateTime?    @map("published_at") @db.Timestamptz(3)
  lastErrorCode     String?      @map("last_error_code") @db.VarChar(40)
  lastError         String?      @map("last_error")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  post          Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount        @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  attemptLog    PublishAttempt[]
  metrics       PostTargetMetrics?
  snapshots     PostMetricSnapshot[]

  @@unique([postId, socialAccountId])
  @@index([status, nextAttemptAt])
  @@index([socialAccountId])
  @@map("post_targets")
}

/// History of each publish attempt, for debugging and support.
model PublishAttempt {
  id           String    @id @default(uuid(7)) @db.Uuid
  postTargetId String    @map("post_target_id") @db.Uuid
  attempt      Int
  outcome      String    @db.VarChar(30)
  errorCode    String?   @map("error_code") @db.VarChar(40)
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)

  postTarget PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@index([postTargetId, startedAt])
  @@map("publish_attempts")
}

// ─── AI writing tools ────────────────────────────────────────────────────────

enum AiFeature {
  CAPTIONS
  HASHTAGS
  REWRITE

  @@map("ai_feature")
}

enum AiRequestStatus {
  /// Reserved against the daily limit; waiting for Claude.
  PENDING
  OK
  /// Declined by Claude's safety classifiers (after any fallback).
  REFUSED
  ERROR
  /// Not sent: the workspace's daily limit was reached.
  QUOTA_EXCEEDED
  /// Not sent: the server's daily spend cap was reached.
  SPEND_CAP_REACHED

  @@map("ai_request_status")
}

/// One AI writing request: usage and cost for limits and reporting, and whether the suggestion was used.
model AiRequest {
  id               String          @id @default(uuid(7)) @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  userId           String?         @map("user_id") @db.Uuid
  feature          AiFeature
  /// The model that answered (can differ from the configured one when a refusal fallback ran).
  model            String          @db.VarChar(60)
  /// Which prompt produced the output, e.g. "captions.v1", so prompt changes can be compared.
  promptVersion    String          @map("prompt_version") @db.VarChar(30)
  status           AiRequestStatus @default(PENDING)
  errorCode        String?         @map("error_code") @db.VarChar(40)
  inputTokens      Int             @default(0) @map("input_tokens")
  outputTokens     Int             @default(0) @map("output_tokens")
  cacheReadTokens  Int             @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int             @default(0) @map("cache_write_tokens")
  /// Estimated cost in millionths of a US dollar.
  costMicros       Int             @default(0) @map("cost_micros")
  latencyMs        Int?            @map("latency_ms")
  /// The suggestions returned, so feedback can be reviewed against them.
  output           Json?
  /// Which suggestion the user applied (0-based), if any.
  appliedIndex     Int?            @map("applied_index")
  /// 1 = thumbs up, -1 = thumbs down.
  rating           Int?            @db.SmallInt
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("ai_requests")
}

/// How the workspace's brand sounds. Included in every AI prompt for the workspace.
model BrandVoice {
  workspaceId String   @id @map("workspace_id") @db.Uuid
  tone        String?  @db.VarChar(200)
  audience    String?  @db.VarChar(300)
  dos         String?  @db.VarChar(1000)
  donts       String?  @db.VarChar(1000)
  samplePost  String?  @map("sample_post") @db.VarChar(2200)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("brand_voices")
}

// ─── Analytics ───────────────────────────────────────────────────────────────

enum MetricsStatus {
  /// Waiting for its first collection.
  PENDING
  OK
  /// The post no longer exists on the platform, or it has no insights; not checked again.
  UNAVAILABLE

  @@map("metrics_status")
}

/**
 * Latest numbers for one published target. Collected on a decaying schedule after publishing
 * (see jobs/analytics.ts); numbers the platform doesn't report for a format stay null.
 */
model PostTargetMetrics {
  postTargetId      String        @id @map("post_target_id") @db.Uuid
  status            MetricsStatus @default(PENDING)
  views             Int?
  reach             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  totalInteractions Int?          @map("total_interactions")
  profileVisits     Int?          @map("profile_visits")
  follows           Int?
  /// Reels only.
  avgWatchTimeMs    Int?          @map("avg_watch_time_ms")
  fetchedAt         DateTime?     @map("fetched_at") @db.Timestamptz(3)
  /// When to collect next; null when collection has finished.
  nextFetchAt       DateTime?     @map("next_fetch_at") @db.Timestamptz(3)
  fetchCount        Int           @default(0) @map("fetch_count")
  lastError         String?       @map("last_error")

  postTarget PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@index([nextFetchAt])
  @@map("post_target_metrics")
}

/**
 * Each collection of a target's numbers, for "how it grew" charts.
 */
model PostMetricSnapshot {
  id                String   @id @default(uuid(7)) @db.Uuid
  postTargetId      String   @map("post_target_id") @db.Uuid
  capturedAt        DateTime @map("captured_at") @db.Timestamptz(3)
  views             Int?
  reach             Int?
  totalInteractions Int?     @map("total_interactions")

  postTarget PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@index([postTargetId, capturedAt])
  @@map("post_metric_snapshots")
}

/**
 * One account's numbers for one day (UTC calendar day).
 */
model AccountDailyStats {
  socialAccountId   String    @map("social_account_id") @db.Uuid
  date              DateTime  @db.Date
  /// Follower count sampled during that day (not from insights, so it works for any account size).
  followers         Int?
  reach             Int?
  views             Int?
  accountsEngaged   Int?      @map("accounts_engaged")
  totalInteractions Int?      @map("total_interactions")
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  profileLinksTaps  Int?      @map("profile_links_taps")
  follows           Int?
  unfollows         Int?
  /// When the insights for this day were last fetched; null while only the follower count is known.
  insightsFetchedAt DateTime? @map("insights_fetched_at") @db.Timestamptz(3)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@id([socialAccountId, date])
  @@map("account_daily_stats")
}

/**
 * When the account's followers are online: average per UTC weekday (0 = Sunday) × hour.
 */
model AccountAudience {
  socialAccountId String   @id @map("social_account_id") @db.Uuid
  /// 7 × 24 numbers, or null when the platform has no data (e.g. under 100 followers).
  onlineGrid      Json?    @map("online_grid")
  fetchedAt       DateTime @map("fetched_at") @db.Timestamptz(3)

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("account_audience")
}

/// When each background job last ran. Used where there's no always-on worker to keep time between runs
/// (the run-jobs endpoint, e.g. on Vercel): a run is claimed by moving last_run_at forward atomically.
model JobRun {
  name      String   @id @db.VarChar(40)
  lastRunAt DateTime @map("last_run_at") @db.Timestamptz(3)

  @@map("job_runs")
}
