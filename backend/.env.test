# Non-secret settings for `npm test`. Safe to commit.
# The test database URL is derived from DATABASE_URL in .env (database name → social_test),
# or set TEST_DATABASE_URL to override it.
NODE_ENV=test
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=test-only-secret-not-used-anywhere-else-0123456789
RATE_LIMIT_AUTH_MAX=1000
