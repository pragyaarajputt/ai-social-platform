# Non-secret settings for `npm test`. Safe to commit.
# The test database URL is derived from DATABASE_URL in .env (database name → social_test),
# or set TEST_DATABASE_URL to override it.
NODE_ENV=test
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
JWT_ACCESS_SECRET=test-only-secret-not-used-anywhere-else-0123456789
RATE_LIMIT_AUTH_MAX=1000
# Base64 of the 32-byte string "test-only-key-not-a-real-secret!". Real keys come from randomBytes(32).
TOKEN_ENCRYPTION_KEY=dGVzdC1vbmx5LWtleS1ub3QtYS1yZWFsLXNlY3JldCE=
# Fake Instagram app: tests replace fetch, so nothing reaches Instagram.
INSTAGRAM_APP_ID=test-instagram-app-id
INSTAGRAM_APP_SECRET=test-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/v1/integrations/instagram/callback
# Fake Facebook app: tests replace fetch, so nothing reaches Facebook.
FACEBOOK_APP_ID=test-facebook-app-id
FACEBOOK_APP_SECRET=test-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/facebook/callback
# Fake LinkedIn app: tests replace fetch, so nothing reaches LinkedIn.
LINKEDIN_CLIENT_ID=test-linkedin-client-id
LINKEDIN_CLIENT_SECRET=test-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/integrations/linkedin/callback
# Fake X app: tests replace fetch, so nothing reaches X.
X_CLIENT_ID=test-x-client-id
X_CLIENT_SECRET=test-x-client-secret
X_REDIRECT_URI=http://localhost:4000/api/v1/integrations/x/callback
# Fake Cloudinary account: tests replace fetch, so nothing is uploaded.
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-cloudinary-key
CLOUDINARY_API_SECRET=test-cloudinary-secret
# Fake Claude: tests replace fetch, so nothing reaches Anthropic and nothing is billed.
ANTHROPIC_API_KEY=test-anthropic-key
AI_MAX_RETRIES=0
AI_REQUESTS_PER_MINUTE=1000
