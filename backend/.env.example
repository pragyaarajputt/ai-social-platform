NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Frontend URL, used in email links and after Google sign-in
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://social_app:CHANGE_ME@localhost:5432/social_dev?schema=public

# Which proxies may set X-Forwarded-For, so rate limits see real client IPs (Express "trust proxy").
# The frontend's /api/v1 rewrite is a proxy: use "loopback" when Next.js runs on the same machine.
# In production, trust only your own load balancer, e.g. a hop count like "1". Unset = trust nobody.
TRUST_PROXY=loopback

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT_AUTH_MAX=20

# Email. Without SMTP_URL, emails are printed to the console.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=AI Social <no-reply@example.com>

# Encrypts connected social accounts' tokens at rest. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing tokens unreadable (accounts must be reconnected).
TOKEN_ENCRYPTION_KEY=CHANGE_ME

# Instagram (Instagram API with Instagram Login). Connecting Instagram is off unless all three are set.
# From your Meta app: Instagram > API setup with Instagram business login. These are the *Instagram*
# app ID and secret, not the Facebook app ID. The redirect URI must match the app settings exactly.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://your-public-host/api/v1/integrations/instagram/callback
# INSTAGRAM_GRAPH_VERSION=v26.0

# Facebook Pages (Facebook Login for Business). Connecting Facebook is off unless the first three are set.
# From your Meta app: App settings > Basic (the Facebook App ID, not the Instagram one). Add the redirect
# URI under Facebook Login for Business > Settings. Optionally create a login configuration (User access
# token; pages_show_list, pages_manage_posts, pages_read_engagement, read_insights, business_management)
# and put its ID in FACEBOOK_CONFIG_ID.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=https://your-public-host/api/v1/integrations/facebook/callback
# FACEBOOK_CONFIG_ID=
# FACEBOOK_GRAPH_VERSION=v26.0

# Cloudinary media storage (cloudinary.com, free tier works). Uploads are off unless all three are set.
# Dashboard > Settings > API Keys. Keep the secret out of git.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=ai-social

# How often the worker checks for posts to publish (ms).
# PUBLISH_POLL_INTERVAL_MS=5000

# AI writing tools (Claude, by Anthropic). Off unless ANTHROPIC_API_KEY is set.
# Key from https://platform.claude.com/settings/keys. Keep it out of git.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5            # or claude-sonnet-5 / claude-haiku-4-5 (cheaper)
# AI_DAILY_REQUESTS_PER_WORKSPACE=50
# AI_DAILY_SPEND_CAP_USD=5          # estimated spend across all workspaces per UTC day
# AI_REQUESTS_PER_MINUTE=10         # per user
# AI_MAX_RETRIES=2

# Google sign-in. Off unless all three are set.
# Redirect URI must match the one registered in Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
